# Caddy config for the `proxy` profile — see docs/integrations/reverse-proxy-tls.md.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically for
# OMNIROUTE_PUBLIC_DOMAIN, and redirects http:// to https:// on its own.
# The ACME HTTP-01 challenge is why port 80 is published alongside 443.
#
# The upstream is the Docker network hostname, not the host's published port:
# traffic never leaves the compose network between Caddy and OmniRoute, so
# DASHBOARD_PORT does not need to be reachable from outside the VPS at all.

{$OMNIROUTE_PUBLIC_DOMAIN} {
	# The agent bridge, served under a path rather than its own subdomain.
	#
	# A name like agent.arject.co would be cleaner, but it needs a DNS A
	# record, and this domain has no wildcard — probed 2026-09-04:
	# gateway and flows resolve to the VPS, any other subdomain does not
	# resolve at all. A path on a name that already resolves needs nothing
	# from DNS, so the bridge is usable now rather than after a DNS change.
	#
	# `handle_path` strips the prefix, so /king-agent/mcp reaches the sidecar
	# as /mcp — which is the path FastMCP serves and the path an MCP client
	# will be pointed at.
	#
	# Safe to reference an upstream from a profile that may not be running:
	# Caddy resolves reverse_proxy upstreams per request, so a missing
	# container yields 502 on this path only. It is an unset *site address*
	# that breaks config load, not an unreachable upstream — see the
	# Activepieces note below.
	handle_path /king-agent/* {
		reverse_proxy agent-sidecar-http:8100 {
			# The MCP transport streams; buffering would stall it, the same
			# reason the gateway below sets this.
			flush_interval -1
		}
	}

	# The code graph, on the same reasoning as the bridge above: a path on a
	# name that already resolves, because this domain has no wildcard record.
	#
	# /king-codegraph/mcp reaches codegraph-serve as /mcp, which is the path
	# `graphify.serve --path /mcp` publishes.
	#
	# No auth layer is added here, unlike nothing else on this domain, because
	# codegraph-serve already enforces its own GRAPHIFY_API_KEY bearer.
	# Verified before this block was written rather than assumed: with the key
	# unset the compose default is an EMPTY string, which would have published
	# a full map of this repo to the open internet. Probed on the VPS —
	# no token gives 401, a wrong token gives 401.
	#
	# Reaching it previously required `ssh -L` every session, which is the
	# whole reason a live, daily-refreshed graph sat unused.
	handle_path /king-codegraph/* {
		reverse_proxy codegraph-serve:8130 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy omniroute-base:{$DASHBOARD_PORT:20128} {
		# OmniRoute streams SSE for /v1/chat/completions and /v1/messages.
		# Caddy does not buffer responses by default, but say so explicitly:
		# a future directive that enables buffering would silently break
		# streaming for every Claude Code and OpenAI-SDK client.
		flush_interval -1

		# OmniRoute restarts itself in normal operation — it ships an
		# auto-restart path (migration 137_auto_restart_adopted) and shuts
		# down gracefully when it fires: drain in-flight requests, checkpoint
		# SQLite, exit 0, and let the restart policy bring it back. Observed
		# once on 2026-08-28 within the first day of running.
		#
		# There is only one upstream, so during that gap Caddy has nothing to
		# fail over to and answers 502 immediately. That turns a few seconds
		# of planned restart into a hard error for every client — including
		# Claude Code, which sees a dead gateway rather than a slow one.
		#
		# Waiting it out is strictly better than failing fast here: a request
		# that takes 5s beats one that fails. Caddy only retries when the
		# connection never succeeded, so a POST cannot be applied twice.
		lb_try_duration 20s
		lb_try_interval 500ms
		}
	}
}

# Activepieces, published only when the `workflow` profile is also running.
# Left out of the `proxy` profile's required set on purpose: someone running
# just `base` + `proxy` has no activepieces container, and Caddy would fail
# every request to this name rather than the site simply not existing.
#
# Publishing this at all rests on one verified fact: Activepieces closes
# registration by itself once the first account creates the platform. Probed
# against this deployment on 2026-08-28 — a second sign-up returns
# 403 INVITATION_ONLY_SIGN_UP and the user table stays at one row. Re-verify
# after any upgrade before trusting this name to stay closed; the older
# AP_SIGN_UP_ENABLED switch was removed upstream and is not available as a
# fallback.
#
# The container listens on 80 internally; 8080 is only the host-side mapping
# and stays bound to loopback, so this is the single public door.
# The default is a .localhost name on purpose. An empty site address makes
# Caddy fail to load the WHOLE config — taking the gateway down with it — and
# any real-looking placeholder would send Caddy off to ACME for a domain
# nobody owns, retrying forever. Caddy issues .localhost certificates from its
# own internal CA without touching the network, so an unset value degrades to
# a site that simply is not reachable from outside, which is the correct
# behaviour for someone running base + proxy without the workflow profile.
{$ACTIVEPIECES_PUBLIC_DOMAIN:activepieces.localhost} {
	reverse_proxy activepieces:80 {
		# Flow runs stream progress over websockets, and the worker holds a
		# long-lived Socket.IO connection. Buffering would stall both.
		flush_interval -1

		# Same reasoning as OmniRoute above: one upstream, so a restart has
		# nowhere to fail over to. Shorter here because a webhook sender is
		# far less patient than an interactive client.
		lb_try_duration 10s
		lb_try_interval 500ms
	}
}
