# Secrets for observability/docker-compose.langfuse.yml — copy to
# observability/.env (gitignored) and fill every value below before running
# the observability profile with real secrets:
#   docker compose --profile observability --env-file observability/.env up
#
# The upstream Langfuse compose file ships insecure inline defaults (marked
# # CHANGEME in the compose file itself) meant only for a five-minute
# throwaway smoke test — never rely on them beyond that. Without this file
# at all, `docker compose --profile base up` (plain OmniRoute) still works
# fine — this file is only read when you explicitly pass --env-file, and
# every Langfuse variable has its own inline fallback in the compose file.
#
#   cp observability/.env.example observability/.env
#
# IMPORTANT: keep each value on the same line as its VAR=, nothing after it.
# A trailing "# comment" on the same line as VAR= is NOT stripped by
# Compose's --env-file parser and becomes part of the value (validated the
# hard way while building this file).

# Langfuse application secrets
# SALT: openssl rand -hex 32
SALT=
# ENCRYPTION_KEY: openssl rand -hex 32
ENCRYPTION_KEY=
# NEXTAUTH_SECRET: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Postgres (Langfuse's own metadata store — separate from OmniRoute's SQLite)
POSTGRES_USER=postgres
# POSTGRES_PASSWORD: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres

# ClickHouse (trace/event storage)
CLICKHOUSE_USER=clickhouse
# CLICKHOUSE_PASSWORD: openssl rand -hex 24
CLICKHOUSE_PASSWORD=

# MinIO (S3-compatible blob storage for event/media uploads)
MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD: openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# Redis (Langfuse's own queue — separate from OmniRoute's rate-limiter redis,
# and on a different host port; see the compose file header comment)
# REDIS_AUTH: openssl rand -hex 24
REDIS_AUTH=
LANGFUSE_REDIS_PORT=16379

# Optional: host port overrides if 3000/9090/5432 are already taken locally
# LANGFUSE_WEB_PORT=3000
# LANGFUSE_MINIO_PORT=9090
# LANGFUSE_POSTGRES_PORT=5432
