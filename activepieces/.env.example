# Activepieces (profil `workflow`) — salin ke activepieces/.env (gitignored).
#   cp activepieces/.env.example activepieces/.env
#
# Postgres dan Redis di sini sengaja diarahkan ke layanan terkelola tier
# gratis (Neon + Upstash), bukan container lokal — itulah yang membuat profil
# ini hanya menambah satu container ke VPS. Lihat
# docs/integrations/activepieces-workflow.md.
#
# PENTING: jangan taruh komentar `# ...` di baris yang sama dengan VAR= —
# parser env_file Compose tidak membuangnya dan komentar itu ikut jadi bagian
# dari nilainya (pelajaran yang sudah didapat lewat observability/.env).

# ── Rahasia aplikasi ────────────────────────────────────────────────────────
# AP_ENCRYPTION_KEY: tepat 32 karakter heksadesimal -> openssl rand -hex 16
AP_ENCRYPTION_KEY=
# AP_JWT_SECRET: openssl rand -hex 32
AP_JWT_SECRET=

# ── URL publik ──────────────────────────────────────────────────────────────
# Dipakai untuk dua hal sekaligus, dan itulah yang membuatnya mudah salah:
#   1. membangun URL webhook dan redirect yang dilihat dunia luar, dan
#   2. alamat yang dipakai worker untuk menyambung ke API lewat Socket.IO.
#
# Kegunaan kedua itu terjadi DI DALAM container, jadi nilainya harus valid dari
# sana — bukan dari host. Container mendengarkan di port 80; angka 8080 hanya
# pemetaan di sisi host (`80/tcp -> 127.0.0.1:8080`). Menulis :8080 di sini
# membuat worker menghubungi port kosong dan gagal dengan
# "Socket.IO connection error" setiap 5 detik — dashboard tetap terlihat
# healthy, tetapi tidak ada flow yang benar-benar dieksekusi. Terjadi sungguhan
# saat deployment pertama ke VPS, 2026-08-28.
#
# Biarkan tanpa port selama akses masih lewat SSH tunnel. Ganti ke
# https://flows.arject.co HANYA setelah subdomain itu benar-benar dilayani oleh
# profil `proxy` — nilai itu memperbaiki keduanya sekaligus, karena worker ikut
# menyambung lewat URL publik tersebut. Trigger webhook dari layanan luar
# (Slack, GitHub) tidak akan pernah bekerja selama nilainya localhost.
AP_FRONTEND_URL=http://localhost

# ── Postgres (Neon) ─────────────────────────────────────────────────────────
# Ambil connection string dari dashboard Neon. Gunakan endpoint POOLED —
# hostname-nya mengandung `-pooler` — karena Activepieces menjaga koneksi
# tetap terbuka dan Neon menyediakan PgBouncer gratis di endpoint itu.
# Contoh: postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/activepieces
AP_POSTGRES_URL=
AP_POSTGRES_USE_SSL=true

# ── Redis (Upstash) ─────────────────────────────────────────────────────────
# Upstash berbicara protokol Redis standar, jadi tidak perlu SDK khusus.
# Isi dari dashboard Upstash (bagian "Redis" -> endpoint & password).
AP_REDIS_TYPE=STANDALONE
AP_REDIS_HOST=
AP_REDIS_PORT=6379
AP_REDIS_PASSWORD=
# Upstash mewajibkan TLS, jadi baris ini memang harus `true`.
# Kalau suatu saat pindah ke Redis lokal tanpa TLS, HAPUS baris ini sepenuhnya
# — mengisinya dengan `false` tetap membuat Activepieces mencoba TLS
# (upstream issue #4857).
AP_REDIS_USE_SSL=true

# ── Eksekusi ────────────────────────────────────────────────────────────────
# UNSANDBOXED menjalankan kode flow langsung di dalam container ini. Itu nilai
# yang benar selama hanya Anda yang menulis flow-nya — penalaran yang sama
# dengan AGENT_SIDECAR_EXECUTOR=local. SANDBOXED baru relevan kalau orang lain
# boleh menjalankan kode yang tidak Anda percayai di instance ini.
AP_EXECUTION_MODE=UNSANDBOXED

AP_ENVIRONMENT=prod
# Matikan telemetri ke cloud Activepieces.
AP_TELEMETRY_ENABLED=false
