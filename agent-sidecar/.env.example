# agent-sidecar secrets — copy to agent-sidecar/.env (gitignored).
#   cp agent-sidecar/.env.example agent-sidecar/.env
#
# Provision OMNIROUTE_API_KEY via OmniRoute's dashboard (Settings > API
# Keys) or POST /api/keys with a session cookie, scoped to the minimum this
# sidecar needs: models, routing, health. Never grant it 'admin' or 'manage'.

OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=
AGENT_SIDECAR_MODEL_ID=opencode/big-pickle

# Optional, opt-in: lets the sidecar load tools from OmniRoute's own MCP
# server (/api/mcp/stream). Validated against a live instance that this
# endpoint requires a 'manage' or 'admin' scoped key — a materially more
# privileged key than OMNIROUTE_API_KEY above. Leave unset unless you
# specifically want MCP tool access and understand that trade-off; see
# docs/integrations/scalability-system.md.
OMNIROUTE_MCP_API_KEY=
