# OmniRoute runtime secrets/data — never commit
/omniroute/.env
/omniroute/data/

# Root-level compose environment (OMNIROUTE_PUBLIC_DOMAIN and anything else
# Compose reads by default). Not secret today, but it is the file operators
# reach for first when a deploy needs one — see docs/integrations/reverse-proxy-tls.md
/.env

# STAX scalability-system tooling — workspace-level, see docs/integrations/
/node_modules/
/repomix-output.*
/graphify-out/
/agent-sidecar/.venv/
/agent-sidecar/.env
/agent-sidecar/__pycache__/
/agent-sidecar/**/__pycache__/
/observability/.env
/activepieces/.env
*.graphify-bak

# Gateway plugins are installed at runtime into omniroute/plugins/ so they
# survive container recreation (see the mount in docker-compose.yml). The
# directory is tracked; what gets installed into it is not — each plugin
# carries its own node_modules, and the langfuse one alone is 2 MB.
omniroute/plugins/*
!omniroute/plugins/.gitkeep

# Kunci provider untuk kolam free tier, dibaca scripts/pool-register.sh.
# Hanya ada di host; contohnya ada di providers.env.example.
/providers.env

# Written by Claude Code itself, per-machine. It accumulates `permissions.allow`
# entries verbatim — which is how a live Neon connection string ended up sitting
# in it in plaintext. It was ignored ONLY by the operator's global git config,
# so on any other machine this file was one `git add -A` from being committed.
.claude/settings.local.json

# Agent skills installed via `npx skills add` — tooling for whoever is driving
# Claude Code here, not part of the deployed system.
.agents/
.claude/skills/

# Every .env VARIANT, not just the exact paths listed above. A backup named
# `activepieces/.env.bak-upstash-20260830` — three live secrets in it — sat
# untracked-but-committable for a day, and was also readable by the OpenHands
# mount, because both the rules above and the /dev/null masks in
# docker-compose.yml match exact filenames and nothing else. Templates stay
# tracked via the negation below.
**/.env.*
!**/.env.example

# That rule was right and too narrow, in two ways C-1 found on 2026-09-10.
#
# It matches a DOT after `.env`, so `.env~` slips past — and `.env~` is what
# vim and nano write when you save `.env`, a byte-for-byte copy of the live
# secrets. Three of them were sitting in this tree: `.env~`,
# `agent-sidecar/.env~`, `activepieces/.env~`.
#
# It also anchors on a basename starting with `.env`, so `providers.env.bak`
# and `providers.env.bak.20260906` matched nothing. `/providers.env` above
# names one exact path; a suffix defeats it, which is the same failure the
# `.env.bak-upstash-20260830` incident above was supposed to have closed.
#
# So: any editor leftover, and any env file whatever its prefix.
*~
*.swp
*.swo
**/*.env
**/*.env.*

# Templates stay tracked. This negation is deliberately wider than
# `!**/.env.example`, which never covered `omniroute/.env.homolog.example` or
# `providers.env.example` — both survive today only because git does not
# apply ignore rules to files it already tracks. Remove and re-add one and it
# would vanish silently.
!**/*.env*.example

# Same treatment for the other file that has held a live credential in
# plaintext. Claude Code appends permissions.allow entries to
# settings.local.json verbatim, which is how a database connection string once
# landed in it — and the exact-path rule above protects the file while leaving
# every copy of it exposed.
.claude/settings.local.json*

# Alert webhook URL + HMAC secret for the pool-prove timer, read via
# EnvironmentFile so the secret never lands in a systemd unit.
/.pool-prove.env

# scripts/king-rotate.sh appends one line per rotation: the credential NAME and
# a UTC timestamp, never a value. Host-local progress, not repository history —
# the names are already public in docs/king-rotation.md, so nothing new leaks,
# but committing it would put a per-machine work log into everyone's diff.
/.rotation-state

# Berkas kerja sementara yang saya buat di root saat menjalankan probe. Salah
# satunya pernah ikut ter-commit karena perintah rm-nya dipindah ke latar
# sebelum sempat jalan.
/_*.py
/_*.tmp
/_*.txt
/_*.yml
